// ====================================================================
// PROJECT: NEUT-STUDIO (E-COMMERCE STREETWEAR ARCHITECTURE)
// FORMAT: DBML (Database Markup Language for dbdiagram.io)
// GENERATED: 2026-11-05
// ====================================================================

Project NeutStudio {
  database_type: 'PostgreSQL'
  Note: '''
    # Neut-Studio Database Schema
    Hệ thống thương mại điện tử thời trang Streetwear (DirtyCoins style).
    - Hỗ trợ biến thể Size/Màu sắc tổ hợp
    - Đơn vị tiền tệ số nguyên VNĐ (bigint)
    - Cơ chế khóa kho nguyên tử (Atomic Stock Reservation)
    - Đánh giá sản phẩm kèm thông số người mặc & form fit
    - Định vị cửa hàng & kiểm tra tồn kho đa chi nhánh
  '''
}

// ==========================================
// 1. AUTH & USERS (Người dùng & Xác thực)
// ==========================================

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  email varchar(255) [unique, not null]
  password_hash varchar(255) [not null]
  full_name varchar(100) [not null]
  phone varchar(20)
  role varchar(20) [not null, default: 'CUSTOMER', note: 'CUSTOMER | ADMIN | STAFF']
  avatar_url varchar(500)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    email [name: 'idx_users_email']
  }
}

Table user_addresses {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  recipient_name varchar(100) [not null]
  phone_number varchar(20) [not null]
  province varchar(100) [not null]
  district varchar(100) [not null]
  ward varchar(100) [not null]
  street_address text [not null]
  is_default boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    user_id [name: 'idx_user_addresses_user_id']
  }
}

Table wishlists {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  product_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, product_id) [unique, name: 'idx_user_product_wishlist']
  }
}

Table newsletter_leads {
  id uuid [pk, default: `gen_random_uuid()`]
  phone varchar(20) [unique, not null, note: 'Số điện thoại nhận voucher NEUT10']
  discount_code_sent varchar(50)
  is_used boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
}

// ==========================================
// 2. CATALOG & PRODUCTS (Sản phẩm & Biến thể)
// ==========================================

Table categories {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(100) [not null]
  slug varchar(120) [unique, not null]
  parent_id uuid [note: 'Hỗ trợ cây danh mục phân cấp đa tầng']
  description text
  image_url varchar(500)
  sort_order int [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    slug [name: 'idx_categories_slug']
  }
}

Table collections {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(150) [not null]
  slug varchar(150) [unique, not null]
  description text
  banner_url varchar(500)
  is_collab boolean [not null, default: false, note: 'Đánh dấu bộ sưu tập Collab như DCxAB']
  isActive boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
}

Table collection_products {
  id uuid [pk, default: `gen_random_uuid()`]
  collection_id uuid [not null]
  product_id uuid [not null]

  indexes {
    (collection_id, product_id) [unique, name: 'idx_collection_product']
  }
}

Table products {
  id uuid [pk, default: `gen_random_uuid()`]
  title varchar(255) [not null]
  slug varchar(255) [unique, not null]
  description text
  material_and_care text [note: 'Hướng dẫn giặt ủi và định lượng vải GSM']
  size_guide_html text
  category_id uuid
  is_published boolean [not null, default: false]
  is_featured boolean [not null, default: false]
  deleted_at timestamptz [note: 'Soft delete để bảo toàn toàn vẹn dữ liệu']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    slug [name: 'idx_products_slug']
    category_id [name: 'idx_products_category_id']
    is_published [name: 'idx_products_published']
  }
}

Table product_variants {
  id uuid [pk, default: `gen_random_uuid()`]
  product_id uuid [not null]
  sku varchar(100) [unique, not null]
  color_name varchar(50) [not null]
  color_hex varchar(10) [not null]
  size varchar(20) [not null, note: 'S, M, L, XL, 28, 30, Freesize']
  price bigint [not null, note: 'Giá gốc VNĐ nguyên số: 299000']
  sale_price bigint [note: 'Giá khuyến mãi VNĐ: 199000']
  stock_quantity int [not null, default: 0, note: 'Ràng buộc CHECK: stock_quantity >= 0']
  thumbnail_url varchar(500)
  deleted_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (product_id, color_name, size) [unique, name: 'idx_variant_product_color_size']
    sku [name: 'idx_variants_sku']
  }
}

Table product_images {
  id uuid [pk, default: `gen_random_uuid()`]
  product_id uuid [not null]
  minio_bucket varchar(100) [not null, default: 'products']
  minio_key varchar(500) [not null]
  image_url varchar(500) [not null]
  color_attached varchar(50) [note: 'Gắn ảnh với màu sắc để đổi ảnh khi chọn màu']
  is_cover boolean [not null, default: false]
  sort_order int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    product_id [name: 'idx_product_images_product_id']
  }
}

Table product_reviews {
  id uuid [pk, default: `gen_random_uuid()`]
  product_id uuid [not null]
  user_id uuid
  customer_name varchar(100) [not null, default: 'Khách hàng Neut']
  rating int [not null, note: '1 - 5 sao']
  fit_score int [not null, default: 0, note: '-1: Hơi chật, 0: Chuẩn form, 1: Rộng oversize']
  user_height_cm int [note: 'Chiều cao thực tế của khách review (cm)']
  user_weight_kg int [note: 'Cân nặng thực tế của khách review (kg)']
  purchased_size varchar(20) [note: 'Size sản phẩm đã mua']
  comment text [not null]
  images jsonb [default: '[]', note: 'Mảng URL ảnh feedback lưu trên MinIO S3']
  is_verified_purchase boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    product_id [name: 'idx_reviews_product_id']
  }
}

Table lookbooks {
  id uuid [pk, default: `gen_random_uuid()`]
  title varchar(200) [not null]
  image_url varchar(500) [not null]
  is_active boolean [not null, default: true]
  sort_order int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
}

Table lookbook_hotspots {
  id uuid [pk, default: `gen_random_uuid()`]
  lookbook_id uuid [not null]
  product_id uuid [not null]
  x_percent int [not null, note: 'Tọa độ X (%) trên ảnh người mẫu']
  y_percent int [not null, note: 'Tọa độ Y (%) trên ảnh người mẫu']
}

// ==========================================
// 3. CARTS, ORDERS & CHECKOUT (Giỏ hàng & Đơn)
// ==========================================

Table carts {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid
  session_id varchar(100) [note: 'Định danh giỏ hàng của khách vãng lai (Guest Cart)']
  updated_at timestamptz [not null, default: `now()`]
}

Table cart_items {
  id uuid [pk, default: `gen_random_uuid()`]
  cart_id uuid [not null]
  variant_id uuid [not null]
  quantity int [not null, default: 1, note: 'Ràng buộc CHECK: quantity > 0']
  created_at timestamptz [not null, default: `now()`]
}

Table coupons {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(50) [unique, not null, note: 'e.g. NEUT10, WELCOME2026']
  discount_type varchar(20) [not null, note: 'PERCENT | FIXED']
  discount_value int [not null]
  max_discount_amount bigint
  min_order_amount bigint [not null, default: 0]
  usage_limit int [not null, default: 100]
  used_count int [not null, default: 0]
  start_date timestamptz [not null, default: `now()`]
  end_date timestamptz [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    code [name: 'idx_coupons_code']
  }
}

Table coupon_usages {
  id uuid [pk, default: `gen_random_uuid()`]
  coupon_id uuid [not null]
  user_id uuid [not null]
  order_id uuid [not null]
  used_at timestamptz [not null, default: `now()`]
}

Table orders {
  id uuid [pk, default: `gen_random_uuid()`]
  order_code varchar(50) [unique, not null, note: 'e.g. NEUT-20261105-9988']
  user_id uuid
  customer_name varchar(100) [not null]
  customer_phone varchar(20) [not null]
  customer_email varchar(150) [not null]
  shipping_address jsonb [not null, note: '{ province, district, ward, street }']
  subtotal bigint [not null, note: 'Tiền hàng trước giảm giá (VNĐ)']
  shipping_fee bigint [not null, default: 0]
  discount_amount bigint [not null, default: 0]
  total_amount bigint [not null, note: 'Tổng tiền phải thanh toán (VNĐ)']
  payment_method varchar(20) [not null, note: 'COD | PAYOS | VNPAY']
  payment_status varchar(20) [not null, default: 'PENDING', note: 'PENDING | PAID | FAILED']
  order_status varchar(20) [not null, default: 'PENDING', note: 'PENDING | CONFIRMED | SHIPPING | COMPLETED | CANCELLED']
  expires_at timestamptz [note: 'Đồng hồ đếm ngược 15 phút cho mã VietQR PayOS']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    order_code [name: 'idx_orders_code']
    order_status [name: 'idx_orders_status']
    created_at [name: 'idx_orders_created_at']
  }
}

Table order_items {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null]
  variant_id uuid [note: 'ON DELETE SET NULL: Bảo toàn lịch sử bán hàng khi xóa SKU']
  product_title varchar(255) [not null, note: 'Snapshot tên sản phẩm tại thời điểm mua']
  variant_sku varchar(100) [not null]
  variant_color varchar(50) [not null]
  variant_size varchar(20) [not null]
  unit_price bigint [not null, note: 'Snapshot đơn giá tại thời điểm mua']
  quantity int [not null, note: 'Ràng buộc CHECK: quantity > 0']
  total_price bigint [not null]

  indexes {
    order_id [name: 'idx_order_items_order_id']
  }
}

Table payment_transactions {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null]
  provider varchar(20) [not null, note: 'PAYOS | VNPAY']
  provider_transaction_id varchar(100) [unique, not null, note: 'Idempotency chống trùng lặp Webhook']
  amount bigint [not null]
  status varchar(20) [not null]
  raw_payload jsonb
  created_at timestamptz [not null, default: `now()`]

  indexes {
    order_id [name: 'idx_payment_transactions_order_id']
    provider_transaction_id [name: 'idx_payment_provider_tx_id']
  }
}

// ==========================================
// 4. STORES & INVENTORIES (Cửa hàng & Tồn kho)
// ==========================================

Table stores {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(150) [not null]
  address varchar(255) [not null]
  city varchar(100) [not null, note: 'TP. Hồ Chí Minh | Hà Nội | Hải Phòng']
  phone varchar(20)
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
}

Table store_inventories {
  id uuid [pk, default: `gen_random_uuid()`]
  store_id uuid [not null]
  variant_id uuid [not null]
  stock_quantity int [not null, default: 0]

  indexes {
    (store_id, variant_id) [unique, name: 'idx_store_variant_stock']
  }
}

// ==========================================
// 5. RELATIONSHIPS & FOREIGN KEYS (Khóa ngoại)
// ==========================================

// Users relationships
Ref: user_addresses.user_id > users.id [delete: cascade]
Ref: wishlists.user_id > users.id [delete: cascade]
Ref: wishlists.product_id > products.id [delete: cascade]

// Catalog & Hierarchy
Ref: categories.parent_id - categories.id [delete: set null]
Ref: products.category_id > categories.id [delete: set null]
Ref: collection_products.collection_id > collections.id [delete: cascade]
Ref: collection_products.product_id > products.id [delete: cascade]
Ref: product_variants.product_id > products.id [delete: cascade]
Ref: product_images.product_id > products.id [delete: cascade]
Ref: product_reviews.product_id > products.id [delete: cascade]
Ref: product_reviews.user_id > users.id [delete: set null]
Ref: lookbook_hotspots.lookbook_id > lookbooks.id [delete: cascade]
Ref: lookbook_hotspots.product_id > products.id [delete: cascade]

// Cart relationships
Ref: carts.user_id > users.id [delete: cascade]
Ref: cart_items.cart_id > carts.id [delete: cascade]
Ref: cart_items.variant_id > product_variants.id [delete: cascade]

// Order & Checkout relationships
Ref: orders.user_id > users.id [delete: set null]
Ref: order_items.order_id > orders.id [delete: cascade]
Ref: order_items.variant_id > product_variants.id [delete: set null]
Ref: payment_transactions.order_id > orders.id [delete: restrict]
Ref: coupon_usages.coupon_id > coupons.id [delete: cascade]
Ref: coupon_usages.user_id > users.id [delete: cascade]
Ref: coupon_usages.order_id > orders.id [delete: cascade]

// Store Inventory relationships
Ref: store_inventories.store_id > stores.id [delete: cascade]
Ref: store_inventories.variant_id > product_variants.id [delete: cascade]

// ==========================================
// 6. LOGICAL TABLE GROUPS (Phân nhóm trực quan)
// ==========================================

TableGroup Auth_And_Users {
  users
  user_addresses
  wishlists
  newsletter_leads
}

TableGroup Catalog_And_Streetwear {
  categories
  collections
  collection_products
  products
  product_variants
  product_images
  product_reviews
  lookbooks
  lookbook_hotspots
}

TableGroup Carts_And_Orders {
  carts
  cart_items
  orders
  order_items
  payment_transactions
  coupons
  coupon_usages
}

TableGroup Stores_And_Retail {
  stores
  store_inventories
}
